---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", (post) => !!post.data.publishedDate);

// Sort by date descending
const postsSortedByDate = posts.sort(
	(a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
	title={"Articles"}
	ogDescription="Articles on web development, tutorials, and tech insights. Updated regularly with new learnings."
>
	<h1 class="page-heading">Blog</h1>

	<ul class="mt-12 flex flex-col gap-6">
		{
			postsSortedByDate.map((article) => {
				const slug = article.slug.replace(`en/`, "");
				const url = `/blog/${slug}`;

				return (
					<li class="relative">
						<a href={url}>
							<span class="absolute inset-0" />
							<h2 class="font-bold">{article.data.title}</h2>
						</a>
						{article.data.ogDescription}
					</li>
				);
			})
		}
	</ul>
</BaseLayout>
