---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
	title: string;
	ogDescription: string;
	publishedDate: Date;
}

const { title, ogDescription, publishedDate } = Astro.props;

// Format date according to the current locale
const formattedDate = publishedDate.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

// Get the back link text and URL based on language
const backLinkText = "← Back to articles";
---

<BaseLayout title={title} {ogDescription}>
	<article class="prose prose-lg max-w-none">
		<header class="mb-8">
			<h1 class="mb-4 text-4xl font-bold">{title}</h1>
			<div class="text-gray-600 dark:text-gray-400">
				<time datetime={publishedDate.toISOString()}>
					{formattedDate}
				</time>
			</div>
		</header>

		<div class="article-content">
			<slot />
		</div>
	</article>

	<hr class="my-8 opacity-0" />

	<script
		is:inline
		src="https://giscus.app/client.js"
		data-repo="ViggieM/ViggieM.github.io"
		data-repo-id="R_kgDOMrR1jg"
		data-category="General"
		data-category-id="DIC_kwDOMrR1js4CzVPg"
		data-mapping="title"
		data-strict="0"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="top"
		data-theme="light"
		data-lang="en"
		crossorigin="anonymous"
		async></script>

	<nav class="mt-12">
		<a href="/articles" class="text-blue-600 hover:underline dark:text-blue-400">
			{backLinkText}
		</a>
	</nav>
</BaseLayout>
