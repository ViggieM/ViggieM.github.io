---
import Base from "@layouts/Base.astro";

interface Props {
	title: string;
	ogDescription: string;
}

const { title, ogDescription } = Astro.props;
---

<Base title={`${title} | Viggie.dev`} description={ogDescription}>
	<div class="container mx-auto max-w-4xl px-4 py-8">
		<slot />
	</div>
</Base>
