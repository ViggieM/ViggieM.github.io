---
import { LINKEDIN_URL, GITHUB_URL } from "@/consts";

// Build footer URLs using Astro's i18n utilities
const impressumUrl = `/impressum`;
const privacyUrl = `/privacy`;
const contactUrl = `/contact`;

const today = new Date();
---

<footer
	class="text-gray px-4 py-8 pb-24 text-center md:mt-12"
	style="background: linear-gradient(rgba(229, 233, 240, 0.5), #fff) no-repeat;"
>
	<span class="text-sm">&copy; {today.getFullYear()} Victor Movileanu. All rights reserved.</span>
	<div class="mt-2 flex justify-center gap-2">
		<a href={LINKEDIN_URL} target="_blank" class="flex">
			<span class="sr-only">See Victor's LinkedIn profile</span>
			<span class="icon-[mdi--linkedin] size-5" aria-hidden="true"></span>
		</a>
		<a href={GITHUB_URL} target="_blank" class="flex">
			<span class="sr-only">Go to Victor's GitHub repo</span>
			<span class="icon-[mdi--github] size-5" aria-hidden="true"></span>
		</a>
	</div>
	<div class="mt-4 flex justify-center gap-4 text-sm">
		<a href={impressumUrl} class="text-accent-dark hover:text-accent">
			<span>Impressum</span>
		</a>
		<span class="cursor-default">|</span>
		<a href={privacyUrl} class="text-accent-dark hover:text-accent">
			<span>Privacy</span>
		</a>
		<span class="cursor-default">|</span>
		<a href={contactUrl} class="text-accent-dark hover:text-accent">
			<span>Contact</span>
		</a>
	</div>
</footer>
